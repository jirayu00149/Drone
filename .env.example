# Public browser-safe Supabase values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional drone bridge values for Raspberry Pi / companion computer.
# Use wss:// when this page is served from Cloudflare HTTPS. ws:// is only for local HTTP testing.
DRONE_TELEMETRY_WS=wss://your-pi-or-tunnel.example/ws
DRONE_VIDEO_URL=
DRONE_AUTO_START_CAMERA=true

# Server-only values. Never expose these in frontend JavaScript.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
